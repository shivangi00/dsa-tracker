# The settings the app needs online, explained step by step in DEPLOY.md.
# This file is only a LIST OF NAMES with example values. The app never reads it.
# Type the real values into your host's Environment Variables page instead
# (Vercel: Project → Settings → Environment Variables; Render: Service → Environment).
# Never put real passwords in this file or anywhere else in the project.

# ---- Database (Neon: Connect → JDBC) ----
# The app uses the POOLED address (host contains "-pooler"): many app copies share Neon's pool.
DB_URL=jdbc:postgresql://ep-example-123456-pooler.eu-west-2.aws.neon.tech/neondb?sslmode=require
DB_USER=neondb_owner
DB_PASSWORD=change-me
# Migrations use the DIRECT address (same host without "-pooler"). Flyway reuses DB_USER/DB_PASSWORD.
SPRING_FLYWAY_URL=jdbc:postgresql://ep-example-123456.eu-west-2.aws.neon.tech/neondb?sslmode=require
# Connections per app copy. Small, because Vercel may run several copies.
DB_POOL_SIZE=3
# Let idle connections close so Neon can sleep when the site is quiet
DB_MIN_IDLE=0

# ---- Security ----
COOKIE_SECURE=true

# ---- Optional: complexity analysis by Claude (leave unset to use the free built-in estimate) ----
# ANTHROPIC_API_KEY=sk-ant-...
# ANALYSIS_MODEL=claude-haiku-4-5-20251001

# ---- Vercel only: the port the app listens on (Vercel's default is 80) ----
PORT=8080
